# ==============================================================================
# Ethereum Fraud Detection & Risk Intelligence Platform - Backend Configuration
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (for CORS and CSRF allowance)
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas connection string)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ethereum_fraud_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ethereum_fraud_dev

# Global API Rate Limiting (15 minutes, 100 requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication & Session Security (Stage 2)
# Min 32 random characters in production (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_production_32chars_minimum
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_production_32chars_minimum
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Auth Endpoint Specific Rate Limiting (15 minutes, 10 attempts per IP)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Future Service Integrations (Stage 3+)
# Python Machine Learning Inference Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=dev_ml_service_key_placeholder

# Ethereum Blockchain Data Sources
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE
