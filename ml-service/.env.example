# ==============================================================================
# Ethereum Fraud Detection ML Service - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security
ML_SERVICE_API_KEY=dev_ml_service_key_placeholder
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Model Configuration (Stage 2+)
MODEL_ARTIFACTS_DIR=./artifacts
MODEL_VERSION=v1.0.0
MODEL_FILENAME=xgboost_fraud_detector_v1.joblib
SCALER_FILENAME=feature_scaler_v1.joblib
FEATURE_NAMES_FILENAME=selected_features_v1.json

# Inference Configuration
RISK_THRESHOLD_HIGH=0.75
RISK_THRESHOLD_MEDIUM=0.45
SHAP_EXPLAINER_ENABLED=True
